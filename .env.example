# Anthropic API Configuration for AI Agent
# Option 1: Official Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: Custom endpoint (e.g., llmgate.app)
# ANTHROPIC_AUTH_TOKEN=your_token_here
# ANTHROPIC_BASE_URL=https://llmgate.app
# ANTHROPIC_DEFAULT_SONNET_MODEL=gpt-6.1-sol

# Splunk Configuration
SPLUNK_PASSWORD=Admin@123456
SPLUNK_HEC_TOKEN=abcd1234-5678-90ef-ghij-klmnopqrstuv

# Data Generation Settings
GENERATION_INTERVAL=60
THREAT_VOLUME=medium

# Notification Settings
SLACK_WEBHOOK_URL=
EMAIL_SMTP_SERVER=
EMAIL_FROM=
EMAIL_TO=
